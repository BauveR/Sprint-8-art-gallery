DB_PASS=TuNuevaPassSegura
DB_NAME=arte_db
DB_PORT=3306

# Para PlanetScale (producción):
# DB_HOST=aws.connect.psdb.cloud
# DB_USER=xxxxxxxxxx
# DB_PASS=pscale_pw_xxxxxxxxxx
# DB_NAME=art-gallery-db
# DB_PORT=3306

# ========================================
